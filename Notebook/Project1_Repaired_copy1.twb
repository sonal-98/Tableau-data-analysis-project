    <worksheet name='Q4)part 4'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Review themes</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='googleplaystore.csv+ (Multiple Connections)' name='federated.0imwo1815oqkbn1gbiibd1yecl7b' />
          </datasources>
          <datasource-dependencies datasource='federated.0imwo1815oqkbn1gbiibd1yecl7b'>
            <column datatype='string' name='[App]' role='dimension' type='nominal' />
            <column caption='Rating group' datatype='string' name='[Calculation_1268052330840071]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Rating]&gt;=4.0 then &quot;High Rated&quot;&#13;&#10;ELSEIF [Rating]&lt;4.0 THEN &quot;Low Rated&quot;&#13;&#10;END' />
            </column>
            <column caption='Review theme' datatype='string' name='[Calculation_1268052333699080]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS(LOWER([Translated_Review]), &quot;crash&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;bug&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;error&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;freeze&quot;)&#13;&#10;THEN &quot;Bugs / Crashes&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER([Translated_Review]), &quot;ad&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;ads&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;advert&quot;)&#13;&#10;THEN &quot;Advertisements&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER([Translated_Review]), &quot;login&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;sign in&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;password&quot;)&#13;&#10;THEN &quot;Login / Access&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER([Translated_Review]), &quot;payment&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;pay&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;purchase&quot;)&#13;&#10;THEN &quot;Payment / Purchase&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER([Translated_Review]), &quot;update&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;version&quot;)&#13;&#10;THEN &quot;Updates&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER([Translated_Review]), &quot;slow&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;lag&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;loading&quot;)&#13;&#10;THEN &quot;Performance&quot;&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER([Translated_Review]), &quot;crash&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;error&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;problem&quot;)&#13;&#10;THEN &quot;Technical issue&quot;&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER([Translated_Review]), &quot;language&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;english&quot;)&#13;&#10;THEN &quot;Language&quot;&#13;&#10;&#13;&#10;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
            </column>
            <column caption='Clean_category' datatype='string' name='[Calculation_1400814952710149]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='trim([Category])' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='string' name='[Content Rating]' role='dimension' type='nominal' />
            <column datatype='real' default-format='n#,##0;-#,##0' name='[Rating]' role='measure' type='quantitative' />
            <column datatype='string' name='[Sentiment]' role='dimension' type='nominal' />
            <column caption='Translated Review' datatype='string' name='[Translated_Review]' role='dimension' type='nominal' />
            <column datatype='string' name='[Type]' role='dimension' type='nominal' />
            <column-instance column='[Translated_Review]' derivation='Count' name='[cnt:Translated_Review:qk]' pivot='key' type='quantitative' />
            <column-instance column='[App]' derivation='None' name='[none:App:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1268052330840071]' derivation='None' name='[none:Calculation_1268052330840071:nk]' pivot='key' type='nominal' />
