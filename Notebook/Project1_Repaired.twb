            <column-instance column='[Calculation_1400814951161859]' derivation='None' name='[none:Calculation_1400814951161859:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1400814951161859]' derivation='None' name='[none:Calculation_1400814951161859:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Rating]' derivation='Sum' name='[sum:Rating:qk]' pivot='key' type='quantitative' />
