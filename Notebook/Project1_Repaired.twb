    <worksheet name='M6)3'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Average Days Since Last Update</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='googleplaystore.csv+ (Multiple Connections)' name='federated.0imwo1815oqkbn1gbiibd1yecl7b' />
          </datasources>
          <datasource-dependencies datasource='federated.0imwo1815oqkbn1gbiibd1yecl7b'>
            <column caption='AverageDaysSinceLastUpdate' datatype='real' name='[Calculation_1268052226240514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg(DATEDIFF(&apos;day&apos;,[Last Updated],{MAX([Last Updated])}))' />
            </column>
            <column datatype='date' name='[Last Updated]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1268052226240514]' derivation='User' name='[usr:Calculation_1268052226240514:qk]' pivot='key' type='quantitative' />
