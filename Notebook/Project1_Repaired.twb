            <column aggregation='Sum' caption='Size MB' datatype='real' name='[Calculation_1400814951161859]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF RIGHT([Size], 1) = &quot;M&quot; THEN&#13;&#10;    FLOAT(LEFT([Size], LEN([Size]) - 1))&#13;&#10;&#13;&#10;ELSEIF RIGHT([Size], 1) = &quot;k&quot; THEN&#13;&#10;    FLOAT(LEFT([Size], LEN([Size]) - 1)) / 1024&#13;&#10;&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='Clean_category' datatype='string' name='[Calculation_1400814952710149]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='trim([Category])' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='string' name='[Size]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1400814951161859]' derivation='Avg' name='[avg:Calculation_1400814951161859:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1400814952710149]' derivation='None' name='[none:Calculation_1400814952710149:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.0imwo1815oqkbn1gbiibd1yecl7b].[none:Calculation_1400814952710149:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.0imwo1815oqkbn1gbiibd1yecl7b].[avg:Calculation_1400814951161859:qk]' shelf='rows' />
          </shelf-sorts>
          <aggregation value='true' />
        </view>
