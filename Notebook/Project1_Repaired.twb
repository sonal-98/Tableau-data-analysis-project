      <aliases enabled='yes' />
      <column caption='App (googleplaystore user reviews.csv)' datatype='string' name='[App (googleplaystore_user_reviews.csv)]' role='dimension' type='nominal' />
      <column datatype='string' name='[App]' role='dimension' type='nominal' />
      <column caption='Update Year' datatype='integer' name='[Calculation_1268052225236992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([Last Updated])' />
      </column>
      <column caption='Update Month' datatype='datetime' name='[Calculation_1268052225507329]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[Last Updated])' />
      </column>
      <column caption='AverageDaysSinceLastUpdate' datatype='real' name='[Calculation_1268052226240514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg(DATEDIFF(&apos;day&apos;,[Last Updated],{MAX([Last Updated])}))' />
      </column>
      <column caption='correlation' datatype='real' name='[Calculation_1268052237115396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CORR([Calculation_1400814951161859],[Calculation_1400814950158337])' />
      </column>
      <column caption='Install Band sort' datatype='integer' name='[Calculation_1268052314701829]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1400814950158337] &lt; 1000 THEN 1&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 10000 THEN 2&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 100000 THEN 3&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 1000000 THEN 4&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 10000000 THEN 5&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 100000000 THEN 6&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 1000000000 THEN 7&#13;&#10;&#13;&#10;ELSE 8&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Install band' datatype='string' name='[Calculation_1268052326440966]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1400814950158337] &lt; 1000 THEN &quot;Below 1K&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 10000 THEN &quot;1K - 10K&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 100000 THEN &quot;10K - 100K&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 1000000 THEN &quot;100K - 1M&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 10000000 THEN &quot;1M - 10M&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 100000000 THEN &quot;10M - 100M&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 1000000000 THEN &quot;100M - 1B&quot;&#13;&#10;&#13;&#10;ELSE &quot;1B+&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Rating group' datatype='string' name='[Calculation_1268052330840071]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Rating]&gt;=4.0 then &quot;High Rated&quot;&#13;&#10;ELSEIF [Rating]&lt;4.0 THEN &quot;Low Rated&quot;&#13;&#10;END' />
      </column>
      <column caption='Review theme' datatype='string' name='[Calculation_1268052333699080]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([Translated_Review]), &quot;crash&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;bug&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;error&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;freeze&quot;)&#13;&#10;THEN &quot;Bugs / Crashes&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER([Translated_Review]), &quot;ad&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;ads&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;advert&quot;)&#13;&#10;THEN &quot;Advertisements&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER([Translated_Review]), &quot;login&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;sign in&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;password&quot;)&#13;&#10;THEN &quot;Login / Access&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER([Translated_Review]), &quot;payment&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;pay&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;purchase&quot;)&#13;&#10;THEN &quot;Payment / Purchase&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER([Translated_Review]), &quot;update&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;version&quot;)&#13;&#10;THEN &quot;Updates&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER([Translated_Review]), &quot;slow&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;lag&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;loading&quot;)&#13;&#10;THEN &quot;Performance&quot;&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER([Translated_Review]), &quot;crash&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;error&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;problem&quot;)&#13;&#10;THEN &quot;Technical issue&quot;&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER([Translated_Review]), &quot;language&quot;)&#13;&#10;   OR CONTAINS(LOWER([Translated_Review]), &quot;english&quot;)&#13;&#10;THEN &quot;Language&quot;&#13;&#10;&#13;&#10;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Reviews_clean' datatype='integer' name='[Calculation_1400814944612352]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='INT(REPLACE(STR([Reviews]),&quot;,&quot;,&quot;&quot;))' />
      </column>
      <column aggregation='Sum' caption='Installs clean' datatype='integer' name='[Calculation_1400814950158337]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='int(replace(replace([Installs],&quot;,&quot;,&quot;&quot;),&quot;+&quot;,&quot;&quot;))' />
      </column>
      <column aggregation='Sum' caption='Price_clean' datatype='real' name='[Calculation_1400814950805506]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='float(replace([Price],&quot;$&quot;,&quot;&quot;))' />
      </column>
      <column aggregation='Sum' caption='Size MB' datatype='real' name='[Calculation_1400814951161859]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF RIGHT([Size], 1) = &quot;M&quot; THEN&#13;&#10;    FLOAT(LEFT([Size], LEN([Size]) - 1))&#13;&#10;&#13;&#10;ELSEIF RIGHT([Size], 1) = &quot;k&quot; THEN&#13;&#10;    FLOAT(LEFT([Size], LEN([Size]) - 1)) / 1024&#13;&#10;&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
      </column>
      <column caption='Clean_category' datatype='string' name='[Calculation_1400814952710149]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='trim([Category])' />
      </column>
      <column caption='Clean_genre' datatype='string' name='[Calculation_1400814952996870]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRIM([Genres])' />
      </column>
      <column caption='App count ' datatype='integer' name='[Calculation_1400814967967752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count([App])' />
