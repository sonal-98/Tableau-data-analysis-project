    <worksheet name='9)AvgAppSize'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Arial,sans-serif' fontsize='16'>Average </run>
            <run fontcolor='#000000' fontname='Arial,sans-serif'>app size for each category</run>
          </formatted-text>
        </title>
