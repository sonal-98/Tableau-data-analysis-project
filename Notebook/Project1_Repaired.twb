      <column caption='Exact_dup_check(Combined key)' datatype='string' name='[Calculation_1400814968582153]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[App]&#13;&#10;+ &quot;|&quot; +&#13;&#10;[Category]&#13;&#10;+ &quot;|&quot; +&#13;&#10;STR([Rating])&#13;&#10;+ &quot;|&quot; +&#13;&#10;str([Calculation_1400814944612352])&#13;&#10;+ &quot;|&quot; +&#13;&#10;STR([Calculation_1400814951161859])&#13;&#10;+ &quot;|&quot; +&#13;&#10;str([Calculation_1400814950158337])&#13;&#10;+ &quot;|&quot; +&#13;&#10;[Type]&#13;&#10;+ &quot;|&quot; +&#13;&#10;str([Calculation_1400814950805506])' />
