            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.0imwo1815oqkbn1gbiibd1yecl7b].[usr:Calculation_1268052226240514:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontcolor='#e15759' fontname='Benton Sans Book'>The dataset contains only the latest recorded update date for each app. Therefore, the exact average interval between consecutive updates for the same app cannot be calculated. The analysis instead examines the distribution and frequency of recorded app updates over time.</run>
              </formatted-text>
            </customized-tooltip>
