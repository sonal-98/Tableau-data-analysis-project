    <worksheet name='M7)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Arial,sans-serif' fontsize='18'>Impact of app size on the number of installs</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='googleplaystore.csv+ (Multiple Connections)' name='federated.0imwo1815oqkbn1gbiibd1yecl7b' />
          </datasources>
          <datasource-dependencies datasource='federated.0imwo1815oqkbn1gbiibd1yecl7b'>
            <column datatype='string' name='[App]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Installs clean' datatype='integer' name='[Calculation_1400814950158337]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='int(replace(replace([Installs],&quot;,&quot;,&quot;&quot;),&quot;+&quot;,&quot;&quot;))' />
            </column>
            <column aggregation='Sum' caption='Size MB' datatype='real' name='[Calculation_1400814951161859]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF RIGHT([Size], 1) = &quot;M&quot; THEN&#13;&#10;    FLOAT(LEFT([Size], LEN([Size]) - 1))&#13;&#10;&#13;&#10;ELSEIF RIGHT([Size], 1) = &quot;k&quot; THEN&#13;&#10;    FLOAT(LEFT([Size], LEN([Size]) - 1)) / 1024&#13;&#10;&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Installs]' role='dimension' type='nominal' />
            <column datatype='real' name='[Rating]' role='measure' type='quantitative' />
            <column datatype='string' name='[Size]' role='dimension' type='nominal' />
            <column-instance column='[App]' derivation='None' name='[none:App:nk]' pivot='key' type='nominal' />
