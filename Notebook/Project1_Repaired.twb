            <column caption='Install Band sort' datatype='integer' name='[Calculation_1268052314701829]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1400814950158337] &lt; 1000 THEN 1&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 10000 THEN 2&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 100000 THEN 3&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 1000000 THEN 4&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 10000000 THEN 5&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 100000000 THEN 6&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 1000000000 THEN 7&#13;&#10;&#13;&#10;ELSE 8&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Install band' datatype='string' name='[Calculation_1268052326440966]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1400814950158337] &lt; 1000 THEN &quot;Below 1K&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 10000 THEN &quot;1K - 10K&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 100000 THEN &quot;10K - 100K&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 1000000 THEN &quot;100K - 1M&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 10000000 THEN &quot;1M - 10M&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 100000000 THEN &quot;10M - 100M&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1400814950158337] &lt; 1000000000 THEN &quot;100M - 1B&quot;&#13;&#10;&#13;&#10;ELSE &quot;1B+&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Installs clean' datatype='integer' name='[Calculation_1400814950158337]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='int(replace(replace([Installs],&quot;,&quot;,&quot;&quot;),&quot;+&quot;,&quot;&quot;))' />
            </column>
            <column datatype='string' name='[Installs]' role='dimension' type='nominal' />
